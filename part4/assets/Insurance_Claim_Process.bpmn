        <uipath:entryPointId value="10b130eb-70c7-4487-afbb-c8e9dff83822" />
      </bpmn:extensionElements>
      <bpmn:outgoing>edge_j2lFMX</bpmn:outgoing>
    </bpmn:startEvent>
