    <bpmn:textAnnotation id="Text_fVqkGj">
      <bpmn:text>Start Event – Claim Ready for Review and available supporting documents are ready for processing.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_JB6Ixa">
      <bpmn:text>Fraud Risk Assessment: Retrieves the claim record and evaluates predefined risk indicators.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_RAiiGv">
      <bpmn:text>Download Supporting Document: Downloads the claim PDF from the Data Fabric record.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_kocoA4">
      <bpmn:text>Supervisor Claim Validation: Presents the claim details, supporting document, and risk assessment.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_R8qmFY">
      <bpmn:text>Send Notify Email to Claimant: Sends a notification email to the user.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_tPoiSO">
      <bpmn:text>Reviewer Decision Gateway: Routes the process according to the supervisor's final action.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_2qZGp1">
      <bpmn:text>Settlement Coded Agent: Calculates settlement eligibility.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_rmDoUH">
      <bpmn:text>Generate Approval Email: Generates a concise HTML approval email containing customer details.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Text_o4hY7a">
      <bpmn:text>Send Approve Email: Sends the generated settlement approval email to the claimant's email id.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
