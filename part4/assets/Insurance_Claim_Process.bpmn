  <bpmn:process id="Process_1" name="Insurance_Claim_Process (5)">
    <bpmn:extensionElements>
      <uipath:variables version="v1">
        <uipath:input id="vAction" name="action" type="string" elementId="Process_1" default="Approve" />
      </uipath:variables>
      <uipath:migrationVersion version="21" />
      <uipath:intsvcActivityConfig version="v2" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_mhV0AR" name="Claim Ready for Review">
